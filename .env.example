# Chế độ gọi model:
# - mock: giả lập kết quả để chạy thử khi máy không có GPU
# - vllm: gọi tới vLLM server thật qua OpenAI-compatible API
VLM_MODE=mock

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
MODEL_ID=Qwen/Qwen3-VL-8B-Instruct
VLM_TIMEOUT_SECONDS=60
VLM_MAX_TOKENS=800
MAX_CONCURRENCY=4

MAX_SIDE=1600
PDF_DPI=150
MAX_PDF_PAGES=3
JPEG_QUALITY=90

MAX_FILE_MB=15
MAX_FILES_PER_GROUP=5
STRICT=false
